                "{{carId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"brand\": \"Toyota\",\n    \"model\": \"Corolla Touring Sports\",\n    \"doorsNumber\": 5,\n    \"luggageCapacity\": 598,\n    \"engineCapacity\": 1800,\n    \"fuelType\": 1,\n    \"productionDate\": \"2022-05-10T00:00:00Z\",\n    \"averageFuelConsumption\": 5.9,\n    \"bodyType\": 1\n}",
              "options": {
