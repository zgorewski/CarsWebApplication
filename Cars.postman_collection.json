{
  "info": {
    "_postman_id": "c04facd4-308d-42a2-a0f1-66b7623436e9",
    "name": "Cars API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cars",
      "item": [
        {
          "name": "GET All Cars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Zwraca listę samochodów', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('existingId', list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Car By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{existingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars",
                "{{existingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Zwraca samochód o podanym id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('existingId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Create Car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"brand\": \"Toyota\",\n    \"model\": \"Corolla\",\n    \"doorsNumber\": 5,\n    \"luggageCapacity\": 470,\n    \"engineCapacity\": 1800,\n    \"fuelType\": 1,\n    \"productionDate\": \"2022-05-10T00:00:00Z\",\n    \"averageFuelConsumption\": 6.4,\n    \"bodyType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Nagłówek Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('carId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Update Car",
