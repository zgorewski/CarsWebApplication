          ]
        },
        {
          "name": "POST Create Car – Validation Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"brand\": \"\",\n    \"model\": \"\",\n    \"doorsNumber\": 1,\n    \"luggageCapacity\": -10,\n    \"engineCapacity\": 0,\n    \"fuelType\": 1,\n    \"productionDate\": \"2035-01-01T00:00:00Z\",\n    \"averageFuelConsumption\": -4.5,\n    \"bodyType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const errors = pm.response.json().errors;",
                  "['Brand','Model','DoorsNumber','LuggageCapacity','EngineCapacity','ProductionDate','AverageFuelConsumption']",
                  "  .forEach(f => pm.test('Błąd walidacji: ' + f, () => pm.expect(errors).to.have.property(f)));"
                ]
              }
            }
          ]
        }
      ]
    }
